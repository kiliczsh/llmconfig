# Qwen 3.8 27B — large general-purpose model from Alibaba.
# Source: unsloth/Qwen3.8-27B-GGUF
# Recommended: 16 GB VRAM at UD-IQ3_XXS (~11 GB); Q4 quants (~15-16 GB) are very tight.
# q8_0 KV cache doubles usable context (32k->64k) for ~400MB extra VRAM, no speed loss.
# Beyond ~64k on 16 GB cards, KV cache overflows VRAM and throughput collapses (~52 -> ~20 tok/s).
version: 1
name: qwen38
backend: llama
mode: server
model:
  source: huggingface
  repo: unsloth/Qwen3.8-27B-GGUF
  file: Qwen3.8-27B-UD-IQ3_XXS.gguf           # ~11GB — recommended for 16GB VRAM
  # file: Qwen3.8-27B-Q3_K_M.gguf             # ~12.6GB — slightly higher quality, less headroom
  # file: Qwen3.8-27B-UD-IQ2_M.gguf           # ~9GB — lower quality, more headroom
  download:
    resume: true
server:
  host: 127.0.0.1
  port: 8080
hardware_profiles:
  nvidia:
    n_gpu_layers: 99
    cuda: true
  apple_silicon:
    n_gpu_layers: 99
    metal: true
  cpu:
    n_gpu_layers: 0
context:
  n_ctx: 65536
  flash_attention: on
  cache_type_k: q8_0
  cache_type_v: q8_0
