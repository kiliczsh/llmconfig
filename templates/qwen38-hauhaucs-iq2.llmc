# Qwen 3.8 27B HauhauCS Aggressive IQ2_M — context-oriented text serving.
# Source: https://huggingface.co/HauhauCS/Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-MTP-GGUF
# ~10.32 GB weights. RTX 5070 Ti 16 GB: 128K / Q8 KV / no MTP,
# ~56.6 tok/s on a 2K-token prompt, ~1176 MiB VRAM free (single request).
# 120K-token input verified without truncation: ~844 tok/s prompt, ~31.5 tok/s gen.
# Measurements: docs/benchmarks/qwen38-hauhaucs-iq2-rtx5070ti.md
# 160K leaves only ~54 MiB free; avoid it on this GPU.
# Requires a current llama.cpp build with Qwen3.8 support.
version: 1
name: qwen38-hauhaucs-iq2
backend: llama
mode: server
model:
  source: huggingface
  repo: HauhauCS/Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-MTP-GGUF
  file: Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-IQ2_M.gguf
  checksum: sha256:5e14825174e02733b873cc01358787d570b648dd530c061623764aba743512ce
  download:
    resume: true
  # Context profile: MTP disabled to leave more memory for context.
  # Speed alternative: set n_ctx to 98304 AND uncomment the draft block.
  # Measured ~90.5 tok/s, ~1354 MiB free at 96K with embedded MTP (draft_n=2).
  # No extra draft file is needed. Do not combine MTP with 128K on 16 GB.
  # draft:
  #   spec_type: draft-mtp
  #   draft_n: 2
  # FastMTP is separate: its sidecar requires the publisher's patched runtime.
server:
  host: 127.0.0.1
  port: 8080
  parallel: 1
hardware_profiles:
  nvidia:
    n_gpu_layers: 99
    cuda: true
  apple_silicon:
    n_gpu_layers: 99
    metal: true
  cpu:
    n_gpu_layers: 0
context:
  n_ctx: 131072
  # Use 98304 with the optional embedded MTP block above for higher speed.
  flash_attention: on
  cache_type_k: q8_0
  cache_type_v: q8_0
  n_batch: 2048
  n_ubatch: 512
sampling:
  temperature: 1.0
  top_p: 0.95
  top_k: 20
  min_p: 0.0
  repeat_penalty: 1.0
chat:
  jinja: true
